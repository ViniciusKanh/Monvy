TURSO_DATABASE_URL=libsql://monvy-viniciuskanh.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=coloque-seu-token-aqui

# Auth (gere uma string aleatoria longa)
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa

# Seed admin (usado por: npm run db:init)
ADMIN_EMAIL=viniciussouza742@gmail.com
ADMIN_PASSWORD=12345678
ADMIN_NAME=Vinicius Santos

# Pluggy (Open Finance) — conexao bancaria da tela "Minha Carga Tributaria"
# Crie gratis em https://dashboard.pluggy.ai e cole Client ID / Client Secret.
# NUNCA comitar valores reais: defina na Vercel (Settings > Environment Variables).
PLUGGY_CLIENT_ID=coloque-seu-client-id
PLUGGY_CLIENT_SECRET=coloque-seu-client-secret
# Opcional: URL do widget Pluggy Connect, caso a versao padrao mude
# PLUGGY_CONNECT_URL=https://cdn.pluggy.ai/pluggy-connect/latest/pluggy-connect.js
